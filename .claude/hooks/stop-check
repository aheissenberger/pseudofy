#!/usr/bin/env bash
# Claude Code Stop hook. Block the finish while ./scripts/check fails.
# Exit 0 allows the finish. Exit 2 blocks it and sends stderr to Claude.
set -uo pipefail
cd "${CLAUDE_PROJECT_DIR:-$(dirname "${BASH_SOURCE[0]}")/../..}" || exit 0

input="$(cat)"

# Background agents still work. The session pauses and does not finish.
if [[ "$(jq -r '.background_tasks // [] | length' <<<"$input" 2>/dev/null)" =~ ^[1-9] ]]; then
  exit 0
fi

# No change in the working tree: nothing to check.
if [[ -z "$(git status --porcelain)" ]]; then
  exit 0
fi

if command -v cargo >/dev/null; then
  output="$(./scripts/check 2>&1)"
else
  output="$(devcontainer exec --workspace-folder . ./scripts/check 2>&1)"
fi
status=$?

if ((status != 0)); then
  echo "./scripts/check failed. Fix these errors before you finish:" >&2
  tail -n 60 <<<"$output" >&2
  exit 2
fi
exit 0
